# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# Dominio público, solo para producción (ej: miproyecto.duckdns.org).
# Caddy obtiene el certificado HTTPS automáticamente para este dominio.
DOMAIN=TU-DOMINIO

# PostgreSQL
POSTGRES_DB=multimedia
POSTGRES_USER=multimedia
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# RabbitMQ
RABBITMQ_USER=multimedia
RABBITMQ_PASSWORD=cambia-esto-tambien

# Modo demo (solo producción): los archivos subidos se borran después de este tiempo.
# Ejemplos: 30m, 1h, 2h
DEMO_CLEANUP_RETENTION=1h

# Los archivos subidos ANTES de esta fecha se conservan siempre: son tus archivos de ejemplo.
# Súbelos primero y luego escribe aquí la fecha y hora de ese momento, con tu zona horaria.
# Ejemplo: 2026-11-23T10:00:00-04:00   (vacío = no se conserva ninguno)
DEMO_KEEP_FILES_BEFORE=

# Google Gemini (etiquetado automático de archivos). Se crea en Google AI Studio.
# La lee solo optimizer-service. Vacía = los archivos se procesan sin etiquetas de IA.
GEMINI_API_KEY=

# Modelo de Gemini. gemini-2.5-flash se retira el 1 de diciembre de 2026.
# Lista de modelos vigentes: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
