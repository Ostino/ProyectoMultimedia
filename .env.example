# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env y cambia los valores:
#   cp .env.example .env
# .env está en .gitignore — nunca lo subas al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Una sola base compartida por auth-service y app-service
# (cada uno lleva su propia tabla de historial de Flyway).
POSTGRES_DB=multimedia
POSTGRES_USER=multimedia
POSTGRES_PASSWORD=cambia-esta-contraseña

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Usuario de los servicios y de la consola de administración (http://localhost:15672)
RABBITMQ_USER=multimedia
RABBITMQ_PASSWORD=cambia-esta-contraseña
